# Copy to .env and fill in. .env is gitignored.
# Get these from https://developer.yahoo.com/apps/ after creating an app.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Redirect URI registered on the Yahoo app.
# Port 8077 (not 8080) leaves the default free; nothing actually listens on it,
# the authorization code is read from the browser address bar.
YAHOO_REDIRECT_URI=https://localhost:8077

# League identity. Game key changes every season; league id does not.
YAHOO_LEAGUE_ID=
YAHOO_GAME_KEY=nfl
